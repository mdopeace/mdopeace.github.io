{
  "name": "mdopeace.github.io",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:ui && next dev",
    "build": "npm run build:ui && next build",
    "start": "serve out",
    "lint": "eslint",
    "test": "node --test tests/site.test.mjs",
    "test:ui": "npm run build:ui && vitest run",
    "test:e2e": "playwright test",
    "compare:visual": "node scripts/compare-portfolio.mjs",
    "build:ui": "npm run build --workspace @mdopeace/ui",
    "pack:ui": "npm pack --workspace @mdopeace/ui",
    "test:package": "node scripts/test-ui-package.mjs",
    "test:release": "node --test tests/ui-release.test.mjs"
  },
  "dependencies": {
    "@mdopeace/ui": "0.1.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "tetris-toolkit": "^0.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "~4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.1",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^26.1.0",
    "serve": "~14.2.8",
    "tailwindcss": "~4.3.5",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "workspaces": [
    "packages/*"
  ]
}
